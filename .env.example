# Copia este archivo como .env.local y rellena los valores.
# Los encuentras en Supabase → Project Settings → API (o "Connect").

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Sirve la "anon key" o la nueva "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (para las vistas previas al compartir el enlace)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tamaño máximo por video en MB. El plan gratis de Supabase permite hasta 50 MB por archivo.
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# Muestra el botón "Entrar" en el menú (true/false). Aunque lo ocultes, puedes entrar con /#admin
NEXT_PUBLIC_SHOW_LOGIN_BUTTON=true
